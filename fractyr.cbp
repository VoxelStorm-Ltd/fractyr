					<Add option="-fivopts" />
					<Add option="-fvariable-expansion-in-unroller" />
					<Add option="-freorder-blocks-and-partition" />
					<Add option="-fbranch-target-load-optimize" />
					<Add option="-fuse-linker-plugin" />
					<Add option="-flto" />
					<Add option="-ffast-math" />
					<Add option="-fno-math-errno" />
