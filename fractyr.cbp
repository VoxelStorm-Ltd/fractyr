<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Fractyr" />
		<Option pch_mode="2" />
		<Option default_target="Release" />
		<Option compiler="gcc" />
		<MakeCommands>
			<Build command="" />
			<CompileFile command="" />
			<Clean command="" />
			<DistClean command="" />
			<AskRebuildNeeded command="" />
			<SilentBuild command=" &gt; $(CMD_NULL)" />
		</MakeCommands>
		<Build>
			<Target title="Win32_Debug">
				<Option output="bin/Debug/Fractyr_Win32_debug" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Win32_Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-Og" />
					<Add option="-ggdb3" />
					<Add option="-mthreads" />
					<Add option="-m32" />
					<Add option="-mmmx" />
					<Add option="-msse" />
					<Add option="-msse2" />
					<Add option="-m3dnow" />
					<Add option="-fexceptions" />
					<Add option="-fno-pie" />
					<Add option="-DLOGGING" />
					<Add option="-DIGNORE_DEBUG_INPUTSTORM" />
					<Add option="-DIGNORE_DEBUG_SOUNDSTORM" />
				</Compiler>
				<Linker>
					<Add option="-static" />
					<Add option="-static-libgcc" />
					<Add option="-static-libstdc++" />
					<Add library="lib/win32/libvoro++.a" />
					<Add library="lib/win32/libboost_filesystem-mgw51-mt-sd-1_58.a" />
					<Add library="lib/win32/libboost_system-mgw51-mt-sd-1_58.a" />
					<Add library="lib/win32/libboost_thread-mgw51-mt-sd-1_58.a" />
