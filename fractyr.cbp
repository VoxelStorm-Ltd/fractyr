					<Add library="lib/win32/libftgl_static_D.a" />
					<Add library="lib/win32/libglu32.a" />
					<Add library="lib/win32/libopengl32.a" />
					<Add library="lib/win32/libfreetype.a" />
					<Add library="lib/win32/libOVR_MinGW_Win32_d.a" />
					<Add library="lib/win32/libportaudiocpp_static.a" />
					<Add library="lib/win32/libportaudio_static_x86.a" />
					<Add library="lib/win32/libvorbisfile.a" />
					<Add library="lib/win32/libvorbis.a" />
					<Add library="lib/win32/libogg.a" />
					<Add library="lib/win32/libws2_32.a" />
					<Add library="lib/win32/libgdi32.a" />
					<Add library="lib/win32/libwinmm.a" />
					<Add library="lib/win32/libole32.a" />
