					<Add library="lib/win32/libz.a" />
				</Linker>
			</Target>
			<Target title="Win32_Release">
				<Option output="bin/Release/Fractyr_Win32" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Win32_Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-fomit-frame-pointer" />
					<Add option="-fexpensive-optimizations" />
					<Add option="-Ofast" />
					<Add option="-mthreads" />
					<Add option="-m32" />
					<Add option="-mmmx" />
					<Add option="-msse" />
					<Add option="-msse2" />
